{
  "name": "cleaning-services-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "security:scan": "sh scripts/security/scan-malware.sh --all",
    "check": "yarn lint && yarn type-check && yarn format:check"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
