# Copy to .env.local for local development. Never commit real values.
# Every variable is validated in lib/env.ts — add new ones there too.

# ───── Site ─────
# Public canonical URL (metadata, sitemap, robots, OG images).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───── Contact page email option (optional) ─────
# Leave all of these empty to keep the Contact form WhatsApp-only.
# Set all of them to show a "Send by email" button on /contact.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>.
SMTP_HOST=
SMTP_PORT=
# "true" for port 465, "false" for 587.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to the recipient, e.g. Sparkle Pro <no-reply@example.com>
MAIL_FROM=
# Inbox that receives enquiries.
CONTACT_FORM_RECIPIENT=
